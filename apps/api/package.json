{
  "name": "@sampledge/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sampledge Connect API: NestJS REST + Socket.IO gateway",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "migrate": "node dist/database/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir test"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/websockets": "^12.6.0",
    "@sampledge/contracts": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@sampledge/chat-widget": "workspace:*",
    "@sampledge/connect-sdk": "workspace:*",
    "@sampledge/offline": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "fake-indexeddb": "^6.2.8",
    "smtp-server": "^3.20.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
