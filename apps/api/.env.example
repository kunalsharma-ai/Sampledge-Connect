# SampConnect API. Copy to .env for local development.
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sampledge_connect
REDIS_URL=redis://localhost:6379
# The address people open. The API is served under /api on it (in development
# `node scripts/dev-gateway.mjs` does that on :8080, the gateway in production), so there is
# no CORS to set.
PUBLIC_WEB_URL=http://localhost:8080
# Ed25519 keys (PEM, \n-escaped). Required in production. Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt.key && openssl pkey -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=sampledge-connect
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
# Signed download URL key (32+ chars). Required in production.
FILES_URL_SECRET=
# Absolute base URL of this API (prefixes signed URLs). Defaults to PUBLIC_WEB_URL + /api.
PUBLIC_API_URL=
# Master key for integration secrets stored in MongoDB (32 bytes, base64). Required in
# production. Generate with: openssl rand -base64 32. Third-party services (SMTP, LiveKit,
# push, AI, Sampledge modules...) are connected in Administration > Integrations, not here.
SETTINGS_ENCRYPTION_KEY=
# Bootstraps the first super admin while none exists, as org-slug:email (see docs/super-admin.md).
# Everyone else is added in the Super admin console.
PLATFORM_ADMIN_EMAILS=

# Calls (self-hosted LiveKit). Calls are disabled until these are set. See docs/calls.md.
# Legacy fallback: prefer Administration > Integrations > Calls (LiveKit).
# Defaults to PUBLIC_WEB_URL as ws(s):// (the gateway serves signalling at /rtc). For a local
# LiveKit without the gateway, set it: LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_URL=http://localhost:7880
# LIVEKIT_API_KEY=sampledge
# LIVEKIT_API_SECRET=
# CALL_RING_TIMEOUT_SECONDS=45

# Call recording (self-hosted LiveKit Egress). Off until RECORDINGS_SPOOL_DIR is set.
# See docs/recordings.md.
# RECORDINGS_SPOOL_DIR=/recordings        # where this API reads finished files
# LIVEKIT_EGRESS_OUTPUT_DIR=/out          # the same folder as the egress container sees it
# RECORDING_MAX_BYTES=2147483648          # largest call recording kept (2 GB)
# RECORDING_MAX_MINUTES=240               # recordings stop after this long

# Legacy fallback: prefer Administration > Integrations > Email (SMTP).
# Email to external meeting guests through your own SMTP server. Off until SMTP_HOST and
# SMTP_FROM are set. See docs/guests.md. For a local test mailbox:
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit:v1.27   (then open :8025)
# SMTP_HOST=localhost
# SMTP_PORT=1025                          # 587 (STARTTLS) or 465 with SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false                  # true outside a private network
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="SampConnect <meetings@example.com>"
