# Sampledge Connect API. Copy to .env for local development.
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sampledge_connect
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Ed25519 keys (PEM, \n-escaped). Required in production. Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt.key && openssl pkey -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=sampledge-connect
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
# Signed download URL key (32+ chars). Required in production.
FILES_URL_SECRET=
# Absolute base URL of this API (prefixes signed URLs). Optional.
PUBLIC_API_URL=

# Calls (self-hosted LiveKit). Calls are disabled until these are set. See docs/calls.md.
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_URL=http://localhost:7880
# LIVEKIT_API_KEY=sampledge
# LIVEKIT_API_SECRET=
# CALL_RING_TIMEOUT_SECONDS=45
