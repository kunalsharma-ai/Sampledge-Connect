{
  "expo": {
    "name": "Sampledge Connect",
    "slug": "sampledge-connect",
    "scheme": "sampledge",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080F1F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sampledge.connect",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip"]
      }
    },
    "android": {
      "package": "com.sampledge.connect",
      "adaptiveIcon": {
        "backgroundColor": "#080F1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F8FC",
          "dark": {
            "backgroundColor": "#080F1F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sampledge Connect uses your photos only when you attach them to a message.",
          "cameraPermission": "Sampledge Connect uses your camera when you record a video message.",
          "microphonePermission": "Sampledge Connect uses your microphone when you record a video message."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sampledge Connect uses your microphone for calls, voice messages and video messages."
        }
      ],
      "expo-video",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Sampledge Connect uses your camera for video calls and video messages.",
          "microphonePermission": "Sampledge Connect uses your microphone for calls, voice messages and video messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
