
# Push notifications: `none` stores device tokens but sends nothing; `expo` sends via Expo Push.
PUSH_PROVIDER=none
# EXPO_ACCESS_TOKEN=
# Set to false to send "New message" instead of message text in push bodies.
PUSH_SHOW_PREVIEWS=true

# Calls (self-hosted LiveKit SFU, see docs/calls.md)
LIVEKIT_API_KEY=sampledge
# openssl rand -base64 48
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Server's public IP on a VPS, LAN IP on-premises
LIVEKIT_NODE_IP=127.0.0.1
NEXT_PUBLIC_RTC_URL=ws://localhost:7880

# Host ports. Change any that clash with another program on this machine
# ("address already in use" from `docker compose up`); scripts/check-ports.sh lists clashes.
# WEB_PORT=3000
# API_PORT=4000
# LIVEKIT_HTTP_PORT=7880            # also update LIVEKIT_PUBLIC_URL / NEXT_PUBLIC_RTC_URL
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_TURN_PORT=3478            # UDP
# LIVEKIT_RTC_PORT_START=50000      # UDP media range
# LIVEKIT_RTC_PORT_END=50100
# LIVEKIT_TURN_RELAY_START=50101    # UDP TURN relay range, must not overlap the media range
# LIVEKIT_TURN_RELAY_END=50200
