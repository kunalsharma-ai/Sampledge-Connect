
# Push notifications: `none` stores device tokens but sends nothing; `expo` sends via Expo Push.
PUSH_PROVIDER=none
# EXPO_ACCESS_TOKEN=
# Set to false to send "New message" instead of message text in push bodies.
PUSH_SHOW_PREVIEWS=true

# The address people open: your reverse proxy's domain (it does TLS and forwards to
# http://gateway:80 on the publicweb network). The API is PUBLIC_WEB_URL/api and call
# signalling PUBLIC_WEB_URL/rtc; both follow from this one setting.
PUBLIC_WEB_URL=http://localhost:8080

# Calls (self-hosted LiveKit SFU, see docs/calls.md)
LIVEKIT_API_KEY=sampledge
# openssl rand -base64 48
LIVEKIT_API_SECRET=
# Server's public IP on a VPS, LAN IP on-premises
LIVEKIT_NODE_IP=127.0.0.1

# Networks and ports (docs/deploy.md, "Networks and ports"). Web, API and signalling are not
# published: your proxy reaches http://gateway:80 over the publicweb network. The gateway
# publishes only call media ports. Change any that clash with another program on this machine
# ("address already in use" from `docker compose up`); scripts/check-ports.sh lists clashes.
# LIVEKIT_TCP_PORT=7881             # call media over TCP
# LIVEKIT_UDP_PORT=7882             # call media over UDP: one port for every call
# LIVEKIT_TURN_PORT=3478            # UDP
# LIVEKIT_TURN_RELAY_START=30000    # UDP TURN relay range (callers behind strict NAT);
# LIVEKIT_TURN_RELAY_END=30100      # keep it below 32768 to stay clear of system ports
# Your reverse proxy's Docker network; the gateway joins it so the proxy reaches gateway:80.
# PUBLIC_NETWORK=publicweb
# PUBLIC_NETWORK_EXTERNAL=false     # true when your proxy already created the network

# No proxy yet? Publish the gateway on http://localhost:8080 (loopback only) to try it out:
# COMPOSE_FILE=docker-compose.yml:deploy/local/docker-compose.local.yml
# LOCAL_HTTP_PORT=8080

# Jitsi Meet (optional second call engine, docs/jitsi.md): uncomment to turn it on. Its web
# side is http://gateway:8000 on publicweb; give it its own host name on your proxy.
# COMPOSE_FILE=docker-compose.yml:deploy/jitsi/docker-compose.jitsi.yml
# JITSI_JVB_PORT=10000              # UDP
