{
  "name": "@sampledge/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Sampledge Connect design tokens: five themes, typography, spacing, elevation and motion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes.css": "./dist/themes.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "files": [
    "dist",
    "src/tailwind.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
