{
  "name": "@sampledge/connect-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Server SDK for Sampledge modules: send signed events, contextual chat, identity mapping, widget sign-on, webhook verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sampledge/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
